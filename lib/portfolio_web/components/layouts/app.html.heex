<header class="px-4 sm:px-8 lg:px-10">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 border-b border-zinc-200/80 py-4 sm:items-start sm:gap-8 sm:py-8">
    <a
      href={~p"/"}
      class="shrink-0 font-display text-xs font-semibold tracking-[0.08em] text-zinc-950 transition-opacity duration-200 hover:opacity-60 sm:text-sm"
    >
      ELJHUN EGOT
    </a>
    <nav
      aria-label="Primary"
      class="flex min-w-0 flex-row items-center gap-4 sm:flex-col sm:items-end sm:gap-2.5"
    >
      <.nav_link href={~p"/"} current_path={@current_path} match="/">Home</.nav_link>
      <.nav_link href={~p"/learning"} current_path={@current_path} match="/learning">
        Learning
      </.nav_link>
      <.nav_link href={~p"/projects"} current_path={@current_path} match="/projects">
        Projects
      </.nav_link>
    </nav>
  </div>
</header>
<main class="px-4 sm:px-8 lg:px-10">
  <div class="mx-auto min-w-0 max-w-3xl py-8 sm:py-16 lg:py-20">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
<footer class="px-4 sm:px-8 lg:px-10">
  <div class="mx-auto flex max-w-3xl flex-col gap-3 border-t border-zinc-200/80 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
    <p class="text-sm leading-relaxed text-zinc-400">
      Built while learning · Elixir &amp; Phoenix
    </p>
    <a
      href="https://github.com/ejegot"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center text-sm text-zinc-400 transition-colors duration-200 hover:text-zinc-950 sm:min-h-0"
    >
      GitHub →
    </a>
  </div>
</footer>
