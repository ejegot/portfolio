<header class="px-5 sm:px-8 lg:px-10">
  <div class="mx-auto flex max-w-3xl items-start justify-between gap-8 border-b border-zinc-200/80 py-6 sm:py-8">
    <a
      href={~p"/"}
      class="font-display text-sm font-semibold tracking-[0.08em] text-zinc-950 transition-opacity duration-200 hover:opacity-60"
    >
      ELJHUN EGOT
    </a>
    <nav class="flex flex-col items-end gap-2 sm:gap-2.5">
      <.nav_link href={~p"/"} current_path={@current_path} match="/">Home</.nav_link>
      <.nav_link href={~p"/learning"} current_path={@current_path} match="/learning">
        Learning
      </.nav_link>
      <.nav_link href={~p"/projects"} current_path={@current_path} match="/projects">
        Projects
      </.nav_link>
    </nav>
  </div>
</header>
<main class="px-5 sm:px-8 lg:px-10">
  <div class="mx-auto max-w-3xl py-12 sm:py-16 lg:py-20">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
<footer class="px-5 sm:px-8 lg:px-10">
  <div class="mx-auto flex max-w-3xl flex-col gap-4 border-t border-zinc-200/80 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-zinc-400">
      Built while learning · Elixir &amp; Phoenix
    </p>
    <a
      href="https://github.com/ejegot"
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-zinc-400 transition-colors duration-200 hover:text-zinc-950"
    >
      GitHub →
    </a>
  </div>
</footer>
